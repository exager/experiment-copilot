# Copy to `.env` for local dev. `.env` is gitignored; `.env.example` is committed.
#
# Base URL of the backend API (no trailing slash). Read at build time by Vite.
#   - Local:      http://localhost:8000
#   - Production:  https://<your-service>.onrender.com   (set in Vercel env vars)
VITE_API_URL=http://localhost:8000
