# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored — never commit real secrets.

# ── Google Gemini (used by app/agents/llm.py) ──
GEMINI_API_KEY=your_gemini_key_here

# ── LangSmith tracing (used by app/langsmith_config.py) ──
# Get a key at https://smith.langchain.com/ -> Settings -> API Keys.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your_key_here
LANGCHAIN_PROJECT=experiment-copilot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
